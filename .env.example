# Copy to .env before running docker compose.
# Never commit the populated .env file.

APP_PORT=8081

POSTGRES_DB=smart_portal
POSTGRES_USER=smartportal
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

ADMIN_USERNAME=admin
# Generate with: htpasswd -bnBC 12 "" "your-password" | tr -d ':\n'
ADMIN_PASSWORD=$2a$12$replace.with.a.real.53.character.bcrypt.hash.value

# Generate at least 32 random characters.
APP_SECRET=SmartTenderAuctionPortalSuperSecretKey2026

SMTP_USERNAME=
SMTP_PASSWORD=

# Set true only when the app is behind a trusted reverse proxy that overwrites
# X-Forwarded-For. Direct internet exposure must keep this false.
TRUST_FORWARDED_FOR=false
